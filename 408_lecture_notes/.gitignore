# Local Python environments and bytecode.
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# The GitHub delivery is the editable project directory.
*.zip
*.zip.[0-9][0-9][0-9]

# Keep editable build intermediates and their recorded source fingerprints.
# Page renders, duplicate PDFs and TeX runtime caches are reproducible locally.
/build/**
!/build/**/
!/build/**/*.tex
!/build/**/*.md
!/build/**/*.json
