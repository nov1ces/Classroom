
\begin{tikzpicture}[x=1mm,y=1mm,font=\small,>=Latex,
 nodebox/.style={draw=SNink,fill=SNblue,minimum width=15mm,minimum height=8mm,inner sep=1mm}]
\node[anchor=east,font=\scriptsize] at (23,0) {ordinary};
