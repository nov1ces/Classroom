        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "MHz，则总线带宽是（　）。"
        }
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "A."
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "10"
        },
        {
          "t": "Space"
        },
        {
