    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "【配套例题】"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "假设某系统总线在一个总线周期中并行传输4"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "B信息，一个总线周期占用2个时钟周期，总线时钟频率为10"
