          "c": "MB/s　"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "B."
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "20"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "MB/s　"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "C."
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "40"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "MB/s　"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "D."
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "80"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "MB/s"
        }
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Strong",
          "c": [
            {
              "t": "Str",
              "c": "解析。"
            }
          ]
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "时钟周期100"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "ns，一次总线传送需200"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "ns，传4"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "B，因此带宽"
        },
        {
          "t": "Space"
        },
        {
          "t": "Math",
          "c": [
            {
              "t": "InlineMath"
            },
            "4/(200\\times10^{-9})=20\\times10^6"
          ]
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "B/s，选"
        },
        {
          "t": "Space"
        },
        {
          "t": "Strong",
          "c": [
            {
              "t": "Str",
              "c": "B"
            }
          ]
        },
        {
          "t": "Str",
          "c": "。若直接用4"
        },
        {
          "t": "Space"
        },
        {
          "t": "RawInline",
          "c": [
            "latex",
            "B\\ensuremath{\\times}10"
          ]
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "MHz，就忽略了每次传送占两拍。"
        }
      ]
    },
    {
      "t": "Header",
      "c": [
        3,
        [
          "CO06-example-2",
          [],
          []
        ],
        [
          {
            "t": "Str",
            "c": "例"
          },
          {
            "t": "Space"
          },
          {
            "t": "Str",
            "c": "6-2　已给传送率时不重复乘每周期次数"
          }
        ]
      ]
    },
    {
      "t": "RawBlock",
      "c": [
        "latex",
        "\\begin{example}[自拟数值例]"
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "某64位并行总线每时钟周期传4次数据，实际数据传送率已明确给为1333"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "MT/s，求单方向理想峰值带宽。若改给的是333.25"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "MHz时钟频率，结果是否相同？"
        }
      ]
    },
    {
      "t": "RawBlock",
      "c": [
        "latex",
        "\\end{example}"
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Strong",
          "c": [
            {
              "t": "Str",
              "c": "解析。"
            }
          ]
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "每次64位=8"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "B；1333"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "MT/s就是每秒"
        },
        {
          "t": "Space"
        },
        {
          "t": "Math",
          "c": [
            {
              "t": "InlineMath"
            },
            "1333\\times10^6"
          ]
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "次，带宽为"
        },
        {
          "t": "Space"
        },
        {
          "t": "Math",
          "c": [
            {
              "t": "InlineMath"
            },
            "1333\\times10^6\\times8=10.664"
          ]
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "GB/s。若给333.25"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "MHz且每拍4次，则先算"
        },
        {
          "t": "Space"
        },
        {
          "t": "Math",
          "c": [
            {
              "t": "InlineMath"
            },
            "R=4f=1333"
          ]
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "MT/s，结果相同。若改成1333"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "MHz时钟、仍每拍4次，才会得到42.656"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "GB/s。三个单位条件必须分别使用，不能把“频率”字样覆盖题干明示的物理量。"
        }
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "多通道带宽只有在各通道能够并行传送且工作分配允许时才相加。全双工总线要区分单方向带宽和两个方向合计带宽；校验位若不属于有效载荷，不应计入有效数据量的分子。带宽题第一步宜写出“每次有效几字节、每秒几次”，再统一单位。"
        }
      ]
    },
    {
      "t": "Header",
      "c": [
        2,
        [
          "CO06-transaction",
          [],
          []
        ],
        [
          {
            "t": "Str",
            "c": "一次总线事务从地址到应答"
          }
        ]
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "总线主设备发起事务，从设备按地址被选中并完成操作。CPU常是主设备，DMA控制器也可在取得使用权后成为主设备。主从关系只就本次事务而言，不等于某个设备永久只能发送或只能接收。"
        }
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "一次读事务可以分为：主设备发地址和读命令；从设备译码并准备数据；从设备在数据线上给出有效数据；主设备采样，双方结束本轮操作。写事务则由主设备给出要写的数据。地址、数据若复用同一组线路，就需不同时间片分别传送，不能把这些线路同时算成两份独立的并行位宽。"
        }
      ]
    },
    {
      "t": "Header",
      "c": [
        3,
        [
          "CO06-sync",
          [],
          []
        ],
        [
          {
            "t": "Str",
            "c": "同步定时：固定采样时刻，必要时插等待"
          }
        ]
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "同步总线用共同的时钟约定信号的有效和采样时刻。最短周期必须覆盖信号传播、译码、设备准备及建立时间等延迟。若从设备来不及，可按协议插入等待状态；"
        },
        {
          "t": "Quoted",
          "c": [
            {
              "t": "DoubleQuote"
            },
            [
              {
                "t": "Str",
                "c": "同步"
              }
            ]
          ]
        },
        {
          "t": "Str",
          "c": "不等于所有事务长度永远相同，也不表示每个设备可随意提供互不协调的时钟。"
        }
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "突发传送只给出一个首地址，再连续传送多个相邻数据，分摊地址和启动开销。非突发则可能为每个数据重复地址及准备过程。因此“读一块多长时间”应先数数据拍数，再判断地址、等待代价要付几遍。"
        }
      ]
    },
    {
      "t": "Header",
      "c": [
        3,
        [
          "CO06-example-3",
          [],
