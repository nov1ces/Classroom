{
  "type": "two_panel_resource_timeline",
  "layout": {
    "panels": "上下排列，单缓冲在上，双缓冲在下",
    "time_direction": "left_to_right",
    "same_time_scale": true,
    "axis_start": 0,
    "axis_end": 500,
    "tick_step": 50,
    "stage_styles": {
      "input": "蓝色实心条",
      "copy": "橙色实心条",
      "analysis": "绿色实心条"
    },
    "idle_style": "留白",
    "interval_convention": "所有区间按[开始,结束)表示；边界处可以交接",
    "panel_note": "仅绘出原题前3块；原题总块数仍为10"
  },
  "units": {
    "time": "μs"
  },
  "assumptions": [
    "初始系统缓冲与用户工作区均空；单缓冲为B1，双缓冲交替使用B1、B2。",
    "每块输入100 μs、复制50 μs、分析50 μs；忽略其他开销。",
    "设备一次输入一块；同一系统缓冲的输入与复制不可重叠，复制结束后该系统缓冲可复用。",
    "复制与分析共用一个CPU；只有一个用户工作区，上一块分析完成后才可复制下一块。",
    "设备输入可与CPU处理重叠，受系统缓冲可用性约束。"
  ],
