{
  "type": "双端关闭时序图",
  "title": "例5-4：从C发出FIN起分别计算两端关闭时间",
  "layout": {
    "orientation": "时间由上向下",
    "actors": [
      {
        "id": "C",
        "label": "客户C（主动关闭）",
        "column": 0
      },
      {
        "id": "S",
        "label": "服务器S（被动关闭）",
        "column": 1
      }
    ],
    "time_axis": {
      "unit": "ms",
      "origin": 0,
      "ticks": [
        0,
        25,
        50,
        75,
        1650
      ],
      "axis_break": {
        "after": 75,
        "before": 1650,
        "label": "省略中间时间；C的2MSL从50 ms开始"
      }
    }
  },
  "assumptions": [
    "RTT=50 ms，两个方向单程传播时间均为25 ms。",
    "忽略发送和处理时延，无报文丢失；S收到FIN后应用立即关闭，将ACK与自己的FIN合并发送。",
    "MSL=800 ms，C进入TIME-WAIT后等待2MSL=1600 ms。"
  ],
  "nodes": [
    {
      "id": "C0",
      "actor": "C",
      "time_ms": 0,
      "label": "发送FIN；进入FIN-WAIT-1"
    },
    {
      "id": "S25",
      "actor": "S",
      "time_ms": 25,
      "label": "收到FIN；CLOSE-WAIT→立即发FIN+ACK→LAST-ACK"
    },
    {
      "id": "C50",
      "actor": "C",
      "time_ms": 50,
      "label": "收到FIN+ACK，发最后ACK；进入TIME-WAIT"
    },
    {
      "id": "S75",
      "actor": "S",
      "time_ms": 75,
      "label": "收到最后ACK；进入CLOSED"
    },
    {
      "id": "C1650",
      "actor": "C",
      "time_ms": 1650,
      "label": "2MSL到期；进入CLOSED"
    }
  ],
  "edges": [
    {
      "from": "C0",
      "to": "S25",
      "direction": "C→S",
      "label": "FIN",
      "style": "实线箭头"
    },
    {
      "from": "S25",
      "to": "C50",
      "direction": "S→C",
      "label": "FIN+ACK",
      "style": "实线箭头"
    },
    {
      "from": "C50",
      "to": "S75",
      "direction": "C→S",
      "label": "最后ACK",
      "style": "实线箭头"
    },
    {
      "from": "C50",
      "to": "C1650",
      "direction": "C本地时间向下",
      "label": "TIME-WAIT：2MSL=1600 ms",
      "style": "虚线计时括号"
    }
  ],
  "execution_order": [
    "C0",
    "S25",
    "C50",
    "S75",
    "C1650"
  ],
  "result_labels": [
    "C：50+1600=1650 ms",
    "S：3×25=75 ms",
    "选择D"
  ]
