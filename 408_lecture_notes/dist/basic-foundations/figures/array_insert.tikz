\foreach \v [count=\i from 0] in {10,99,20,30} {
  \node[cell,fill=SNblue] (a\i) at (\i,-1.9) {\v};}
\node[cell,fill=SNpink] at (1,-1.9) {99};
\draw[->,thick,SNrose] (b2.south) -- (a3.north);
\draw[->,thick,SNink] (b1.south) -- (a2.north);
\node[lab,anchor=west] at (3.65,0) {$n=3$};
