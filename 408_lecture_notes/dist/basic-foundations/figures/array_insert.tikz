
\begin{tikzpicture}[x=11mm,y=11mm,font=\small,
  cell/.style={draw=SNink,minimum width=11mm,minimum height=8mm,inner sep=0pt},
  lab/.style={font=\scriptsize,text=SNmuted},>=Latex]
