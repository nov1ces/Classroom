      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Strong",
          "c": [
            {
              "t": "Str",
              "c": "解析。"
            }
          ]
        },
        {
          "t": "Space"
        },
        {
          "t": "Quoted",
          "c": [
            {
              "t": "DoubleQuote"
            },
            [
              {
                "t": "Str",
                "c": "无噪声、带宽、4个幅值"
              }
