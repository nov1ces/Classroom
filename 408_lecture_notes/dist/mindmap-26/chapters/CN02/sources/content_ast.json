        ]
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "基带编码用电平及跳变表示数字数据。非归零"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "NRZ"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "在一个比特间隔保持某一电平，连续相同比特可能没有跳变，时钟恢复困难。反向非归零"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "NRZI"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "用比特起点是否跳变表示数据，具体0、1约定要由题目给出；长串相同比特仍可能缺少跳变，常需填充等机制。"
        }
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "曼彻斯特编码在每个比特中点都跳变，以跳变方向表示数据。本书示意约定低到高为0、高到低为1；题目若采用相反约定，应按题意读图。差分曼彻斯特同样在每个比特中点跳变，但由"
        },
        {
          "t": "Strong",
          "c": [
            {
              "t": "Str",
              "c": "比特起点是否跳变"
            }
          ]
        },
        {
          "t": "Str",
          "c": "表示数据，本书约定起点跳变为0、不跳变为1。判断差分编码的第一位需要知道前一电平；不能只看该位中点的升降方向。"
        }
      ]
    },
