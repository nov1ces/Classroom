        },
        {
          "t": "Str",
          "c": "调制，则该信道的最大数据传输速率是（　）。"
        }
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "A."
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "200"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "kb/s　B."
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "400"
        },
        {
