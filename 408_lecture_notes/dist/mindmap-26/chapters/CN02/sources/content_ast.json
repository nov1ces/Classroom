      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "配套例题。"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "在一条带宽为200"
        },
        {
          "t": "Space"
        },
        {
          "t": "Str",
          "c": "kHz的无噪声信道上，若采用4个幅值的"
