        "\\par\\medskip\\noindent\\textbf{知识导图}\\par\\smallskip\n\\begin{wideblock}\\centering\\includegraphics[width=\\linewidth,height=168mm,keepaspectratio]{figures/map-01.pdf}\\end{wideblock}\\par\\medskip\\clearpage"
      ]
    },
