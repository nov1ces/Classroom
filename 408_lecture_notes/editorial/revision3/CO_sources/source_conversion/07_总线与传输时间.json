          "co-07-02",
          [],
          []
        ],
        [
          {
            "t": "Str",
            "c": "一次总线事务从地址到应答"
          }
        ]
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "总线主设备发起事务，从设备按地址被选中并完成操作。CPU常是主设备，DMA控制器也可在取得使用权后成为主设备。主从指本次事务中的角色，不等于某个设备永久只能发送或只能接收。"
        }
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "一次读事务可以分为：主设备发地址和读命令；从设备译码并准备数据；从设备在数据线上给出有效数据；主设备采样，双方结束本轮操作。写事务则由主设备给出要写的数据。地址、数据若复用同一组线路，就需不同时间片分别传送，不能同时算作两份独立并行位宽。"
        }
      ]
    },
    {
      "t": "Header",
      "c": [
        3,
        [
          "同步定时固定采样时刻必要时插等待",
          [],
          []
        ],
        [
          {
            "t": "Str",
            "c": "同步定时：固定采样时刻，必要时插等待"
          }
        ]
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "同步总线用共同的时钟约定信号有效和采样时刻。最短周期需容纳信号传播、译码、设备准备及建立时间等路径。若从设备来不及，可按协议插入等待状态；"
        },
        {
          "t": "Quoted",
          "c": [
            {
              "t": "DoubleQuote"
            },
            [
              {
                "t": "Str",
                "c": "同步"
              }
            ]
          ]
        },
        {
          "t": "Str",
          "c": "不等于所有事务长度永远相同，也不表示每个设备可随意提供互不协调的时钟。"
        }
      ]
    },
    {
      "t": "Para",
      "c": [
        {
          "t": "Str",
          "c": "突发传送只先给一个首地址，再连续交换多个相邻数据，摊薄地址和启动开销。非突发则可能为每个数据重复地址及准备过程。因此“读一块多长时间”应先数数据拍数，再判断地址、等待代价付几遍。"
        }
      ]
    },
