          ]
        },
        {
          "span": [
            1,
            1
          ],
          "text": "生产者WB前半拍写，消费者ID后半拍读",
          "blocks": [
            {
              "t": "Plain",
              "c": [
                {
                  "t": "Str",
                  "c": "生产者WB前半拍写，消费者ID后半拍读"
