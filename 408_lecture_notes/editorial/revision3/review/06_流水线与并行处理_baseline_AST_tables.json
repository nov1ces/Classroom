        {
          "span": [
            1,
            1
          ],
          "text": "无转发，寄存器同拍不能读写",
          "blocks": [
            {
              "t": "Plain",
              "c": [
                {
                  "t": "Str",
                  "c": "无转发，寄存器同拍不能读写"
                }
              ]
            }
          ]
        },
        {
          "span": [
            1,
            1
          ],
          "text": "必须等生产者WB结束，再在ID读",
          "blocks": [
            {
              "t": "Plain",
              "c": [
                {
                  "t": "Str",
                  "c": "必须等生产者WB结束，再在ID读"
                }
              ]
            }
          ]
        },
        {
          "span": [
            1,
            1
          ],
          "text": "消费者ID至少比生产者WB晚1拍",
          "blocks": [
            {
              "t": "Plain",
              "c": [
                {
                  "t": "Str",
                  "c": "消费者ID至少比生产者WB晚1拍"
